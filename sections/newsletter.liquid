<!-- Newsletter / Join the Studio Section -->
<section class="newsletter-section py-28 px-6 relative overflow-hidden">
  <!-- Decorative background glow -->
  <div class="newsletter-glow"></div>

  <div class="max-w-2xl mx-auto text-center relative z-10 reveal">
    <p class="text-sm tracking-[0.3em] uppercase text-muted-foreground mb-4">{{ section.settings.label }}</p>
    <h2 class="text-4xl md:text-5xl font-serif mb-4">
      {{ section.settings.heading }} <span class="italic text-primary">{{ section.settings.heading_highlight }}</span>
    </h2>
    <p class="text-muted-foreground font-light text-sm md:text-base mb-10 max-w-lg mx-auto leading-relaxed">
      {{ section.settings.description }}
    </p>

    {% form 'customer', id: 'newsletter-form' %}
      <div class="newsletter-form-wrap">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
          class="newsletter-input"
          aria-label="Email address"
        >
        <input type="hidden" name="contact[tags]" value="newsletter">
        <button type="submit" class="newsletter-btn">
          <span class="newsletter-btn__text">{{ section.settings.button_text }}</span>
          <svg class="newsletter-btn__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>

      {% if form.posted_successfully? %}
        <p class="newsletter-success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          {{ section.settings.success_message }}
        </p>
      {% endif %}

      {% if form.errors %}
        <p class="newsletter-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
      {% endif %}
    {% endform %}

    {% if section.settings.show_privacy_note %}
      <p class="text-xs text-muted-foreground/60 mt-6 font-light">{{ section.settings.privacy_note }}</p>
    {% endif %}
  </div>
</section>

<style>
  .newsletter-section {
    background: linear-gradient(180deg, transparent 0%, rgba(234,179,8,0.03) 50%, transparent 100%);
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .newsletter-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(234,179,8,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .newsletter-form-wrap {
    display: flex;
    gap: 0;
    max-width: 480px;
    margin: 0 auto;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .newsletter-form-wrap:focus-within {
    border-color: rgba(234,179,8,0.4);
    box-shadow: 0 0 30px rgba(234,179,8,0.08);
  }
  .newsletter-input {
    flex: 1;
    padding: 1rem 1.25rem;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.02em;
    min-width: 0;
  }
  .newsletter-input::placeholder {
    color: rgba(255,255,255,0.35);
  }
  .newsletter-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background: var(--color-primary, #eab308);
    color: var(--color-primary-foreground, #0a0a0a);
    border: none;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.3s ease, transform 0.2s ease;
  }
  .newsletter-btn:hover {
    background: rgba(234,179,8,0.9);
    transform: translateX(2px);
  }
  .newsletter-btn__arrow {
    transition: transform 0.3s ease;
  }
  .newsletter-btn:hover .newsletter-btn__arrow {
    transform: translateX(3px);
  }
  .newsletter-success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #4ade80;
    font-weight: 400;
  }
  .newsletter-error {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: #f87171;
    font-weight: 400;
  }

  @media (max-width: 480px) {
    .newsletter-form-wrap {
      flex-direction: column;
      border-radius: 0.875rem;
    }
    .newsletter-btn {
      justify-content: center;
      padding: 0.875rem 1.25rem;
    }
    .newsletter-glow {
      width: 300px;
      height: 300px;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Stay Connected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted Word (gold italic)",
      "default": "Studio"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Be the first to know about new designs, studio updates, and exclusive early access to limited-edition drops."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Welcome to the studio. You're in."
    },
    {
      "type": "checkbox",
      "id": "show_privacy_note",
      "label": "Show Privacy Note",
      "default": true
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy Note",
      "default": "No spam, ever. Unsubscribe anytime."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
