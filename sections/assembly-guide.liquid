<div class="px-6 pt-36 pb-24 bg-[#050505] min-h-screen">
  <div class="max-w-7xl mx-auto">
    {% if section.settings.title != blank %}
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-serif text-white mb-4">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="text-muted-foreground font-light max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for block in section.blocks %}
        {% if block.type == 'video' %}
          <div class="group relative bg-white/[0.02] border border-white/[0.05] rounded-2xl overflow-hidden hover:bg-white/[0.04] hover:border-white/10 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-primary/5" {{ block.shopify_attributes }}>
            <!-- Thumbnail -->
            <div class="aspect-video relative overflow-hidden bg-black cursor-pointer" onclick="openAssemblyVideo('{{ block.id }}')">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700">
              {% else %}
                <div class="w-full h-full bg-white/5 flex items-center justify-center text-white/20">
                  {{ 'image' | placeholder_svg_tag: 'w-16 h-16' }}
                </div>
              {% endif %}
              
              <!-- Play Button Overlay -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-16 h-16 bg-black/40 backdrop-blur-md border border-white/20 rounded-full flex items-center justify-center text-white/90 group-hover:text-primary group-hover:border-primary/50 group-hover:bg-primary/10 group-hover:scale-110 transition-all duration-500 shadow-[0_0_15px_rgba(0,0,0,0.5)]">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M5 3l14 9-14 9V3z"/></svg>
                </div>
              </div>

              <!-- Time Badge -->
              {% if block.settings.time != blank %}
                <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md px-3 py-1 rounded text-xs font-medium text-white/90 tracking-wide border border-white/10">
                  {{ block.settings.time }}
                </div>
              {% endif %}
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="text-xl font-serif text-white mb-2 group-hover:text-primary transition-colors">{{ block.settings.title | default: "Assembly Video" }}</h3>
              {% if block.settings.description != blank %}
                <p class="text-sm font-light text-muted-foreground leading-relaxed">{{ block.settings.description }}</p>
              {% endif %}
              
              <!-- Actions -->
              <div class="mt-6 flex items-center gap-4">
                <button onclick="openAssemblyVideo('{{ block.id }}')" class="text-sm font-medium text-primary tracking-widest uppercase hover:text-white transition-colors flex items-center gap-2">
                  Watch Video
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="group-hover:translate-x-1 transition-transform" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
                {% if block.settings.product_url != blank %}
                  <a href="{{ block.settings.product_url }}" class="text-sm font-light text-muted-foreground hover:text-white transition-colors ml-auto">Shop Product</a>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Video Modal Template for this block -->
          <template id="video-modal-{{ block.id }}">
            <div class="w-full aspect-video rounded-xl overflow-hidden shadow-2xl relative bg-black">
              {% if block.settings.video_url.type == 'youtube' %}
                <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&rel=0&showinfo=0" class="absolute inset-0 w-full h-full" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
              {% elsif block.settings.video_url.type == 'vimeo' %}
                <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1" class="absolute inset-0 w-full h-full" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
              {% else %}
                 <!-- Fallback if using manual URL / HTML5 -->
                 <div class="flex items-center justify-center h-full text-white/50 text-sm">Please provide a valid YouTube/Vimeo link.</div>
              {% endif %}
            </div>
          </template>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<!-- Global Assembly Video Modal -->
<div id="AssemblyVideoOverlay" class="fixed inset-0 bg-black/90 backdrop-blur-md z-[100] opacity-0 pointer-events-none transition-all duration-500 ease-out flex items-center justify-center p-4">
  <button id="AssemblyVideoClose" class="absolute top-6 right-6 w-12 h-12 bg-white/5 border border-white/10 rounded-full flex items-center justify-center text-white hover:text-primary hover:bg-white/10 hover:rotate-90 transition-all duration-300 z-50">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <div id="AssemblyVideoContainer" class="w-full max-w-5xl transform scale-95 opacity-0 transition-all duration-500 ease-out">
    <!-- Injected iFrame goes here -->
  </div>
</div>

<script>
  function openAssemblyVideo(blockId) {
    const template = document.getElementById('video-modal-' + blockId);
    if (!template) return;
    
    const overlay = document.getElementById('AssemblyVideoOverlay');
    const container = document.getElementById('AssemblyVideoContainer');
    
    // Inject content
    container.innerHTML = template.innerHTML;
    
    // Show Modal
    document.body.style.overflow = 'hidden';
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('opacity-100', 'pointer-events-auto');
    
    // Animate container in
    setTimeout(() => {
      container.classList.remove('scale-95', 'opacity-0');
      container.classList.add('scale-100', 'opacity-100');
    }, 50);
  }

  function closeAssemblyVideo() {
    const overlay = document.getElementById('AssemblyVideoOverlay');
    const container = document.getElementById('AssemblyVideoContainer');
    
    // Animate container out
    container.classList.remove('scale-100', 'opacity-100');
    container.classList.add('scale-95', 'opacity-0');
    
    // Hide Modal
    setTimeout(() => {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      container.innerHTML = ''; // Clear iframe to stop video
    }, 300);
  }

  document.getElementById('AssemblyVideoClose').addEventListener('click', closeAssemblyVideo);
  document.getElementById('AssemblyVideoOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeAssemblyVideo();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeAssemblyVideo();
  });
</script>

{% schema %}
{
  "name": "Assembly Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Assembly Guides"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Watch step-by-step videos to set up your Ravora lamps perfectly."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Installation Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Video Thumbnail"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Video Title",
          "default": "Lamp Assembly"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Brief Description",
          "default": "Learn how to put together your lamp in a few easy steps."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "default": "https://www.youtube.com/watch?v=_9VUPq31TC8"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Est. Time",
          "default": "5 mins"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Assembly Guide",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}
