<div class="max-w-7xl mx-auto px-6 py-20 mt-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
    <!-- ═══════════════════════════════════════════ -->
    <!-- LEFT: Multi-Image Gallery                   -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="w-full">
      <!-- Main Image -->
      <div id="MainImageWrap" class="rounded-2xl overflow-hidden bg-white/5 aspect-[4/5] relative mb-4 cursor-zoom-in group">
        {% if product.featured_image %}
          <img id="MainProductImage"
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            loading="eager">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50' }}
        {% endif %}
      </div>

      <!-- Thumbnail Strip -->
      {% if product.images.size > 1 %}
        <div class="grid grid-cols-5 gap-3">
          {% for image in product.images %}
            <button
              type="button"
              class="product-thumbnail rounded-lg overflow-hidden bg-white/5 aspect-square border-2 transition-all duration-300 {% if forloop.first %}border-primary{% else %}border-transparent hover:border-white/20{% endif %}"
              data-img-src="{{ image | image_url: width: 1200 }}"
              data-index="{{ forloop.index0 }}"
              onclick="switchImage(this)">
              <img src="{{ image | image_url: width: 200 }}" alt="{{ product.title | escape }} - Image {{ forloop.index }}" class="w-full h-full object-cover" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- RIGHT: Product Info + Accordions + Trust    -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="flex flex-col">
      <!-- Breadcrumb -->
      <nav class="text-xs text-muted-foreground mb-6 tracking-widest uppercase font-light">
        <a href="{{ routes.root_url }}" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        {% if product.collections.size > 0 %}
          <a href="{{ product.collections.first.url }}" class="hover:text-primary transition-colors">{{ product.collections.first.title }}</a>
          <span class="mx-2">/</span>
        {% endif %}
        <span class="text-white">{{ product.title }}</span>
      </nav>

      <!-- Title + Price -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif mb-3 text-white tracking-tight">{{ product.title }}</h1>

      {% if product.compare_at_price > product.price %}
        <div class="flex items-center gap-3 mb-8">
          <p class="text-3xl text-primary font-bold" style="text-shadow: 0 0 12px rgba(234,179,8,0.4);">{{ product.price | money }}</p>
          <p class="text-lg text-muted-foreground line-through font-light">{{ product.compare_at_price | money }}</p>
          <span class="bg-primary/15 text-primary text-xs font-medium px-2.5 py-1 rounded-full tracking-wide">
            SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
          </span>
        </div>
      {% else %}
        <p class="text-3xl text-primary font-bold mb-8" style="text-shadow: 0 0 12px rgba(234,179,8,0.4);">{{ product.price | money }}</p>
      {% endif %}

      <!-- Short Description -->
      <div class="text-muted-foreground font-light text-sm md:text-[15px] mb-8 leading-relaxed">
        {{ product.description | strip_html | truncate: 200 }}
      </div>

      <!-- Variant Selector (if variants exist) -->
      {% if product.variants.size > 1 %}
        <div class="mb-8">
          {% for option in product.options_with_values %}
            <div class="mb-4">
              <label class="block text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-3">{{ option.name }}</label>
              <div class="flex flex-wrap gap-2">
                {% for value in option.values %}
                  <button type="button"
                    class="variant-option px-4 py-2 rounded-lg border text-sm font-light transition-all duration-300 {% if option.selected_value == value %}border-primary text-primary bg-primary/10{% else %}border-white/10 text-white/70 hover:border-white/30 hover:text-white{% endif %}"
                    data-option-name="{{ option.name }}"
                    data-option-value="{{ value }}">
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Add to Cart -->
      <form method="post" action="/cart/add" class="border-t border-white/10 pt-8 mb-8">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex items-center justify-between border border-white/10 rounded-xl px-4 py-2 bg-white/5 w-full sm:w-32">
            <button type="button" onclick="this.nextElementSibling.stepDown()" class="text-white hover:text-primary text-xl px-2">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" class="w-10 bg-transparent text-white text-center focus:outline-none font-medium appearance-none">
            <button type="button" onclick="this.previousElementSibling.stepUp()" class="text-white hover:text-primary text-xl px-2">&plus;</button>
          </div>
          <button type="submit" class="flex-grow bg-primary text-primary-foreground px-8 py-4 rounded-xl font-medium tracking-widest uppercase text-sm hover:bg-primary/90 transition-all hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(234,179,8,0.3)]">
            Add to Cart
          </button>
        </div>
      </form>

      <!-- ═══════════════════════════════════════ -->
      <!-- Detail Accordions                       -->
      <!-- ═══════════════════════════════════════ -->
      <div class="border-t border-white/10">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details class="product-accordion group border-b border-white/10" {{ block.shopify_attributes }}>
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none">
                <div class="flex items-center gap-3">
                  {% if block.settings.icon == 'material' %}
                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>
                  {% elsif block.settings.icon == 'care' %}
                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/></svg>
                  {% elsif block.settings.icon == 'shipping' %}
                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                  {% elsif block.settings.icon == 'dimensions' %}
                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg>
                  {% else %}
                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
                  {% endif %}
                  <span class="text-sm font-medium text-white">{{ block.settings.title }}</span>
                </div>
                <svg class="w-4 h-4 text-muted-foreground transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="pb-5 text-sm text-muted-foreground font-light leading-relaxed pl-8">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      <!-- ═══════════════════════════════════════ -->
      <!-- Buy Assurance / Trust Badges            -->
      <!-- ═══════════════════════════════════════ -->
      <div class="mt-8 grid grid-cols-2 gap-4">
        <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.06] rounded-xl px-4 py-4">
          <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          <div>
            <p class="text-xs font-medium text-white">Secure Checkout</p>
            <p class="text-[10px] text-muted-foreground font-light">SSL encrypted payment</p>
          </div>
        </div>

        <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.06] rounded-xl px-4 py-4">
          <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
          <div>
            <p class="text-xs font-medium text-white">Free Shipping</p>
            <p class="text-[10px] text-muted-foreground font-light">Above ₹1500</p>
          </div>
        </div>

        <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.06] rounded-xl px-4 py-4">
          <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>
          <div>
            <p class="text-xs font-medium text-white">Easy Returns</p>
            <p class="text-[10px] text-muted-foreground font-light">14-day return policy</p>
          </div>
        </div>

        <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.06] rounded-xl px-4 py-4">
          <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
          <div>
            <p class="text-xs font-medium text-white">Handcrafted Quality</p>
            <p class="text-[10px] text-muted-foreground font-light">Each piece individually inspected</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Image Gallery JavaScript -->
<script>
  function switchImage(thumb) {
    var mainImg = document.getElementById('MainProductImage');
    if (mainImg) {
      mainImg.style.opacity = '0';
      setTimeout(function() {
        mainImg.src = thumb.getAttribute('data-img-src');
        mainImg.style.opacity = '1';
      }, 200);
    }
    // Update active thumbnail border
    document.querySelectorAll('.product-thumbnail').forEach(function(t) {
      t.classList.remove('border-primary');
      t.classList.add('border-transparent');
    });
    thumb.classList.remove('border-transparent');
    thumb.classList.add('border-primary');
  }

  // Optional: keyboard navigation for thumbnails
  document.addEventListener('DOMContentLoaded', function() {
    var mainImg = document.getElementById('MainProductImage');
    if (mainImg) {
      mainImg.style.transition = 'opacity 0.2s ease, transform 0.5s ease';
    }
  });
</script>

<style>
  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Product Details",
  "settings": [],
  "blocks": [
    {
      "type": "accordion",
      "name": "Detail Section",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Premium quality materials and expert craftsmanship.</p>"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "info", "label": "Info" },
            { "value": "material", "label": "Material / Composition" },
            { "value": "care", "label": "Care / Features" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "dimensions", "label": "Dimensions" }
          ],
          "default": "info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "title": "Materials & Composition",
            "content": "<p>3D printed using plant-based bioplastics (PLA) and recycled bio-polymers. Each layer is precisely deposited to create a unique light-diffusing texture.</p>",
            "icon": "material"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Features & Specifications",
            "content": "<p>• LED compatible (bulb not included)<br>• E27 socket type<br>• 3D printed sculptural body<br>• Hand-finished surface<br>• Indoor use only<br>• Cord length: 1.5m with switch</p>",
            "icon": "care"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Dimensions",
            "content": "<p>Varies by model. Typical range:<br>• Height: 20–35 cm<br>• Width: 15–25 cm<br>• Weight: 300g – 800g</p>",
            "icon": "dimensions"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Shipping & Delivery",
            "content": "<p>Each lamp is made to order. Please allow 5–7 business days for production.<br>• Free shipping on orders above ₹1500<br>• Carefully packed in custom protective casing<br>• Pan-India delivery via tracked courier</p>",
            "icon": "shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
