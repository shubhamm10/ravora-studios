<div class="max-w-7xl mx-auto px-6 py-24 min-h-[60vh] flex flex-col items-center">
  <div class="w-full max-w-5xl flex flex-col">
    <!-- Header -->
    <div class="flex items-end justify-between border-b border-white/10 pb-6 mb-12">
      <h1 class="text-4xl md:text-5xl font-serif tracking-wide">Your Cart</h1>
      <a href="{{ routes.all_products_collection_url }}" class="text-primary hover:text-primary/80 transition-colors text-sm uppercase tracking-widest font-light hidden sm:block">
        Continue Shopping
      </a>
    </div>

    <!-- Cart Body -->
    {% if cart.item_count == 0 %}
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mb-6">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <h2 class="text-2xl font-serif tracking-wide mb-4">Your cart is empty</h2>
        <a href="{{ routes.all_products_collection_url }}" class="inline-block mt-6 text-primary hover:text-primary/80 text-sm tracking-widest uppercase font-light border border-primary/20 hover:border-primary px-8 py-4 rounded-xl transition-all">
          Start Shopping
        </a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="w-full">
        <div class="flex flex-col lg:flex-row gap-12 xl:gap-16">
          
          <div class="w-full lg:w-2/3">
            <div class="hidden sm:grid grid-cols-[3fr_1fr_1fr_1fr] gap-4 mb-4 text-xs tracking-widest uppercase text-muted-foreground pb-4 border-b border-white/10">
              <div>Product</div>
              <div class="text-center">Price</div>
              <div class="text-center">Quantity</div>
              <div class="text-right">Total</div>
            </div>
            
            <div class="space-y-8 sm:space-y-0 sm:divide-y sm:divide-white/10">
              {% for item in cart.items %}
                <div class="py-6 flex flex-col sm:grid sm:grid-cols-[3fr_1fr_1fr_1fr] sm:items-center gap-6 sm:gap-4 relative group">
                  <!-- Product Image & Meta -->
                  <div class="flex items-center gap-6">
                    {% if item.image %}
                      <a href="{{ item.url }}" class="w-24 h-24 sm:w-20 sm:h-20 bg-white/5 rounded-lg overflow-hidden flex-shrink-0 border border-white/5 block">
                        <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" loading="lazy" class="w-full h-full object-cover">
                      </a>
                    {% endif %}
                    <div class="flex flex-col">
                      <a href="{{ item.url }}" class="hover:text-primary transition-colors text-lg sm:text-base font-serif tracking-wide mb-1">{{ item.product.title | escape }}</a>
                      {% if item.variant.title != 'Default Title' %}
                        <p class="text-sm text-muted-foreground font-light">{{ item.variant.title }}</p>
                      {% endif %}
                      <a href="{{ item.url_to_remove }}" class="text-xs text-muted-foreground hover:text-white uppercase tracking-widest mt-3 sm:hidden underline underline-offset-4 w-max">
                        Remove
                      </a>
                    </div>
                  </div>

                  <!-- Price -->
                  <div class="text-left sm:text-center text-sm">
                    <span class="sm:hidden text-muted-foreground mr-2 font-light text-xs uppercase tracking-widest">Price:</span>
                    {{ item.price | money }}
                  </div>

                  <!-- Quantity -->
                  <div class="flex items-center justify-start sm:justify-center">
                    <span class="sm:hidden text-muted-foreground mr-4 font-light text-xs uppercase tracking-widest">Qty:</span>
                    <div class="flex items-center border border-white/20 rounded-lg overflow-hidden bg-white/5">
                      <button type="submit" name="updates[{{ item.key }}]" value="{{ item.quantity | minus: 1 }}" class="w-8 h-8 flex items-center justify-center hover:bg-white/10 hover:text-primary transition-colors">&minus;</button>
                      <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" class="w-10 h-8 bg-transparent text-center text-sm border-none focus:ring-0 [-moz-appearance:_textfield] [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none" aria-label="quantity">
                      <button type="submit" name="updates[{{ item.key }}]" value="{{ item.quantity | plus: 1 }}" class="w-8 h-8 flex items-center justify-center hover:bg-white/10 hover:text-primary transition-colors">&plus;</button>
                    </div>
                  </div>

                  <!-- Total -->
                  <div class="text-left sm:text-right font-medium text-lg sm:text-base flex items-center justify-between sm:block">
                    <span class="sm:hidden text-muted-foreground font-light text-xs uppercase tracking-widest">Total:</span>
                    {{ item.final_line_price | money }}
                  </div>
                  
                  <!-- Remove block desktop group hover -->
                  <a href="{{ item.url_to_remove }}" class="hidden sm:flex absolute right-0 top-6 items-center justify-center w-8 h-8 text-muted-foreground hover:text-white opacity-0 group-hover:opacity-100 transition-opacity translate-x-12" aria-label="Remove item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                  </a>
                </div>
              {% endfor %}
            </div>
            
            <div class="flex justify-between items-center mt-8 pt-8 border-t border-white/10">
              <a href="{{ routes.all_products_collection_url }}" class="text-muted-foreground hover:text-white transition-colors text-xs uppercase tracking-widest hidden sm:inline-block underline underline-offset-4">
                &larr; Continue Shopping
              </a>
              <button type="submit" name="update" class="text-sm font-light tracking-widest uppercase text-muted-foreground hover:text-primary transition-colors px-6 py-3 border border-white/20 rounded-lg hover:border-primary ms-auto">
                Update Cart
              </button>
            </div>
          </div>
          
          <!-- Order Summary Sidebar -->
          <div class="w-full lg:w-1/3">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8 sticky top-24">
              <h3 class="text-xl font-serif tracking-wide border-b border-white/10 pb-6 mb-6">Order Summary</h3>
              
              <div class="space-y-4 mb-8">
                <div class="flex justify-between items-center text-muted-foreground">
                  <span class="font-light">Subtotal</span>
                  <span class="text-white">{{ cart.items_subtotal_price | money }}</span>
                </div>
                <!-- Shipping note -->
                <div class="flex justify-between items-center text-muted-foreground text-sm border-t border-white/5 pt-4">
                  <span class="font-light">Shipping</span>
                  <span>Calculated at checkout</span>
                </div>
                <!-- Total -->
                <div class="flex justify-between items-center border-t border-white/10 pt-6 mt-6">
                  <span class="text-lg tracking-widest uppercase">Total</span>
                  <span class="text-2xl font-serif text-primary">{{ cart.total_price | money }}</span>
                </div>
              </div>

              {% if section.settings.show_cart_note %}
                <div class="mb-8">
                  <label for="CartNote" class="block text-sm text-muted-foreground font-light mb-3">Add a note to your order</label>
                  <textarea name="note" id="CartNote" class="w-full bg-[#0a0a0a] border border-white/20 rounded-xl p-4 text-sm text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none h-24 placeholder:text-white/30" placeholder="Optional notes...">{{ cart.note }}</textarea>
                </div>
              {% endif %}

              <button type="submit" name="checkout" class="w-full bg-primary text-primary-foreground text-center px-8 py-4 rounded-xl font-medium tracking-widest uppercase text-sm hover:bg-primary/90 transition-all hover:-translate-y-0.5 shadow-[0_4px_14px_0_rgba(234,179,8,0.39)]">
                Proceed to Checkout
              </button>
              
            </div>
          </div>
          
        </div>
      </form>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "default": true,
      "label": "Enable cart notes"
    }
  ]
}
{% endschema %}
