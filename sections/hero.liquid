<section class="relative min-h-screen flex flex-col items-center justify-center pt-28 pb-0 overflow-hidden">
  <!-- Gold ambient glow behind heading -->
  <div class="absolute top-[30%] left-1/2 -translate-x-1/2 w-[800px] h-[600px] pointer-events-none" style="background: radial-gradient(ellipse, rgba(234,179,8,0.05) 0%, rgba(234,179,8,0.015) 40%, transparent 65%);"></div>
  <!-- Faint watermark behind the carousel -->
  <div class="absolute bottom-[10%] left-1/2 -translate-x-1/2 text-[18vw] font-serif italic text-white/[0.03] whitespace-nowrap pointer-events-none select-none leading-none tracking-tight z-0">
    {{ section.settings.watermark_text }}
  </div>

  <!-- Hero text content -->
  <div class="text-center px-6 relative z-10 mb-12">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif leading-tight tracking-tight mb-8">
      {{ section.settings.heading_line_1 }}<br>
      <span class="italic text-primary">{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_line_2 }}<br>
      {{ section.settings.heading_line_3 }}
    </h1>
    <a href="{{ section.settings.button_link }}" class="inline-block bg-primary text-primary-foreground px-10 py-4 rounded-xl text-sm tracking-widest uppercase font-medium hover:bg-primary/90 transition-all hover:-translate-y-0.5">
      {{ section.settings.button_text }}
    </a>
  </div>
  
  <!-- Auto-scrolling product marquee carousel -->
  <div class="hero-marquee-viewport" id="heroMarquee-{{ section.id }}">
    <div class="hero-marquee-track">
      {% assign marquee_collection = section.settings.marquee_collection | default: 'all' %}
      {% assign product_collection = collections[marquee_collection] %}
      {% if product_collection.products.size > 0 %}
        {% for product in product_collection.products %}
          <a href="{{ product.url }}" class="hero-marquee-card group" draggable="false">
            <div class="hero-marquee-card__image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" draggable="false">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}
              {% endif %}
            </div>
            <p class="hero-marquee-card__title">{{ product.title }}</p>
            <p class="hero-marquee-card__price">{{ product.price | money }}</p>
          </a>
        {% endfor %}
        <!-- Duplicate sets for seamless infinite loop -->
        {% for product in product_collection.products %}
          <a href="{{ product.url }}" class="hero-marquee-card group" draggable="false">
            <div class="hero-marquee-card__image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" draggable="false">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}
              {% endif %}
            </div>
            <p class="hero-marquee-card__title">{{ product.title }}</p>
            <p class="hero-marquee-card__price">{{ product.price | money }}</p>
          </a>
        {% endfor %}
        {% for product in product_collection.products %}
          <a href="{{ product.url }}" class="hero-marquee-card group" draggable="false">
            <div class="hero-marquee-card__image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" draggable="false">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}
              {% endif %}
            </div>
            <p class="hero-marquee-card__title">{{ product.title }}</p>
            <p class="hero-marquee-card__price">{{ product.price | money }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..12) %}
          <div class="hero-marquee-card">
            <div class="hero-marquee-card__image"></div>
            <p class="hero-marquee-card__title">Sample Lamp</p>
            <p class="hero-marquee-card__price">₹2,499</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="flex justify-center py-12 text-muted-foreground animate-bounce">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
  </div>
</section>

<style>
  .hero-marquee-viewport {
    width: 100vw;
    overflow: hidden;
    position: relative;
    z-index: 10;
    margin-top: 2rem;
    margin-left: calc(-50vw + 50%);
  }
  .hero-marquee-track {
    display: flex;
    gap: 0;
    will-change: transform;
  }
  .hero-marquee-card {
    flex-shrink: 0;
    width: calc(100vw / 5);
    padding: 0 8px;
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    -webkit-user-drag: none;
  }
  @media (max-width: 1024px) {
    .hero-marquee-card { width: calc(100vw / 3); }
  }
  @media (max-width: 640px) {
    .hero-marquee-card { width: calc(100vw / 2); }
  }
  .hero-marquee-card__image {
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 3/4;
    background: rgba(255,255,255,0.05);
    margin-bottom: 0.75rem;
  }
  .hero-marquee-card__title {
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 2px;
  }
  .hero-marquee-card__price {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary, #eab308);
    letter-spacing: 0.02em;
    padding: 0 2px;
  }
</style>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var speed = {{ section.settings.marquee_speed | default: 30 }};
    /* Convert speed setting to pixels per second — lower setting = faster */
    var pxPerSec = 1800 / speed;
    var viewport = document.getElementById('heroMarquee-' + sectionId);
    if (!viewport) return;
    var track = viewport.querySelector('.hero-marquee-track');
    if (!track) return;

    var cards = track.querySelectorAll('.hero-marquee-card');
    if (cards.length === 0) return;

    /* Calculate the width of one "set" of original products */
    var totalCards = cards.length;
    var oneSetCount = Math.round(totalCards / 3);
    var paused = false;
    var offset = 0;
    var lastTime = null;

    function getOneSetWidth() {
      var w = 0;
      for (var i = 0; i < oneSetCount && i < cards.length; i++) {
        w += cards[i].offsetWidth;
      }
      return w;
    }

    function animate(now) {
      if (!lastTime) lastTime = now;
      var dt = (now - lastTime) / 1000;
      lastTime = now;

      if (!paused) {
        offset += pxPerSec * dt;
        var oneSetW = getOneSetWidth();
        if (oneSetW > 0 && offset >= oneSetW) {
          offset -= oneSetW;
        }
        track.style.transform = 'translateX(' + (-offset) + 'px)';
      }
      requestAnimationFrame(animate);
    }

    viewport.addEventListener('mouseenter', function() { paused = true; });
    viewport.addEventListener('mouseleave', function() { paused = false; lastTime = null; });
    viewport.addEventListener('touchstart', function() { paused = true; }, { passive: true });
    viewport.addEventListener('touchend', function() { paused = false; lastTime = null; });

    requestAnimationFrame(animate);
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading Line 1",
      "default": "Architectural 3D Printed"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted Word (gold italic)",
      "default": "Ambient Lamps"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Text after highlight",
      "default": "for"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading Line 3",
      "default": "Modern Interiors."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Product Marquee"
    },
    {
      "type": "collection",
      "id": "marquee_collection",
      "label": "Marquee Collection"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Watermark"
    },
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Watermark Text",
      "default": "RAVORA"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
