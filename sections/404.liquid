<!-- Custom 404 Page -->
<section class="min-h-[80vh] flex items-center justify-center px-6 py-20 relative overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full" style="background: radial-gradient(circle, rgba(234,179,8,0.05) 0%, transparent 70%);"></div>

  <div class="text-center relative z-10 reveal">
    <p class="text-[8rem] md:text-[12rem] font-serif text-white/[0.04] leading-none select-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap pointer-events-none">404</p>
    <p class="text-sm tracking-[0.3em] uppercase text-muted-foreground mb-6">Page Not Found</p>
    <h1 class="text-4xl md:text-5xl font-serif mb-4">Lost in the <span class="italic text-primary">Light</span></h1>
    <p class="text-muted-foreground font-light text-sm md:text-base mb-10 max-w-md mx-auto leading-relaxed">
      The page you're looking for doesn't exist or may have been moved. Let's guide you back.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="inline-block bg-primary text-primary-foreground px-8 py-4 rounded-xl text-sm tracking-widest uppercase font-medium hover:bg-primary/90 transition-all hover:-translate-y-0.5">
        Back to Home
      </a>
      <a href="/collections/all" class="inline-block glass text-white px-8 py-4 rounded-xl text-sm tracking-widest uppercase font-medium hover:bg-white/10 transition-all hover:-translate-y-0.5">
        Browse Collection
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
