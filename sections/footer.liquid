<!-- Newsletter + Footer -->
<footer class="mt-auto">
  <!-- Newsletter -->
  <div class="border-t border-white/10 py-20 px-6 bg-zinc-950">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-10">
      <div>
        <h3 class="text-2xl md:text-3xl font-serif italic mb-2">Stay in the Light</h3>
        <p class="text-sm text-muted-foreground font-light">New designs, materials, and studio updates.</p>
      </div>
      <form class="flex gap-3 w-full md:w-auto">
        <input type="email" placeholder="Your email" class="bg-white/5 border border-white/10 rounded-lg px-5 py-3 text-sm font-light text-white placeholder-zinc-500 focus:outline-none focus:border-primary/50 w-full md:w-72 transition-colors">
        <button type="submit" class="bg-primary text-primary-foreground px-6 py-3 rounded-lg text-sm font-medium tracking-widest uppercase hover:bg-primary/90 transition-all whitespace-nowrap">
          Join
        </button>
      </form>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10 py-8 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm">
      <a href="{{ routes.root_url }}" class="font-serif italic text-xl tracking-tight">Ravora</a>
      
      <nav class="flex gap-8 text-xs tracking-[0.2em] uppercase text-muted-foreground font-light">
        <a href="/collections/all" class="hover:text-white transition-colors">Collection</a>
        <a href="/pages/about" class="hover:text-white transition-colors">About</a>
      </nav>
      
      <div class="flex flex-col items-center md:items-end gap-3 text-xs text-muted-foreground font-light">
        <!-- Dynamic Policy Links -->
        <div class="flex flex-wrap justify-center gap-4">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}" class="hover:text-white transition-colors">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <p>© {{ 'now' | date: '%Y' }} RAVORA. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
