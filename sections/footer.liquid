<footer class="mt-auto">
  <!-- Top Footer: Navigation Links -->
  <div class="border-t border-white/10 py-16 px-6 bg-zinc-950">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-center gap-10">
      <nav class="flex flex-wrap justify-center gap-8 text-xs tracking-[0.2em] uppercase text-muted-foreground font-light">
        <a href="/collections/all" class="hover:text-white transition-colors">Collection</a>
        <a href="/pages/about" class="hover:text-white transition-colors">About</a>
        <a href="/pages/contact" class="hover:text-white transition-colors">Contact</a>
      </nav>
    </div>
  </div>

  <!-- Bottom bar: Logo + Policies + Copyright -->
  <div class="border-t border-white/10 py-8 px-6">
    <div class="max-w-7xl mx-auto flex flex-col items-center gap-6 text-center">
      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="font-serif italic text-xl tracking-tight">Ravora</a>

      <!-- Policy Links -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-muted-foreground font-light">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}" class="hover:text-white transition-colors">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Copyright -->
      <p class="text-xs text-muted-foreground font-light">© {{ 'now' | date: '%Y' }} RAVORA. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
