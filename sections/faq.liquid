<!-- FAQ / Accordion Section -->
<section class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-sm tracking-[0.3em] uppercase text-muted-foreground mb-4">{{ section.settings.label }}</p>
      <h2 class="text-4xl md:text-5xl font-serif">{{ section.settings.heading }} <span class="italic text-primary">{{ section.settings.heading_highlight }}</span></h2>
    </div>

    <div class="faq-list reveal">
      {% for block in section.blocks %}
        <details class="faq-item group" {{ block.shopify_attributes }}>
          <summary class="faq-question">
            <span>{{ block.settings.question }}</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg>
          </summary>
          <div class="faq-answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .faq-item {
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .faq-item:first-child {
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    color: #fff;
    list-style: none;
    transition: color 0.3s ease;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::marker { display: none; content: ''; }
  .faq-question:hover {
    color: var(--color-primary, #eab308);
  }
  .faq-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
    color: rgba(255,255,255,0.4);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-primary, #eab308);
  }
  .faq-answer {
    padding: 0 0 1.5rem 0;
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
    max-width: 90%;
  }
  .faq-answer p {
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted Word (gold italic)",
      "default": "Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How are the lamps made?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Each lamp is 3D printed layer by layer using advanced FDM technology, then hand-finished and assembled with integrated LED lighting.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How are the lamps made?", "answer": "<p>Each lamp is 3D printed layer by layer using advanced FDM technology over 12–24 hours, then hand-finished to ensure flawless quality. LED lighting is carefully integrated during final assembly.</p>" } },
        { "type": "faq", "settings": { "question": "What materials do you use?", "answer": "<p>We use plant-based bioplastics (PLA) and recycled bio-polymers. These materials are sustainable, durable, and produce a beautiful diffused light effect.</p>" } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders are typically dispatched within 3–5 business days. Since each piece is made on-demand, please allow up to 7–10 business days for delivery.</p>" } },
        { "type": "faq", "settings": { "question": "Can I customize a lamp?", "answer": "<p>Yes! We accept custom orders for color, size, and design modifications. Reach out to us at hello@ravora.studio for custom inquiries.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer returns?", "answer": "<p>We offer a 14-day return policy for undamaged products in original packaging. Custom orders are non-returnable.</p>" } }
      ]
    }
  ]
}
{% endschema %}
