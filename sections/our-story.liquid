<!-- Our Story Section -->
<section class="py-24 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-4xl md:text-5xl font-serif mb-8">{{ section.settings.heading }} <span class="italic text-primary">{{ section.settings.heading_highlight }}</span></h2>
    <p class="text-muted-foreground font-light leading-relaxed text-base md:text-lg mb-16">
      {{ section.settings.description }}
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-12 sm:gap-20">
      {% for block in section.blocks %}
        <div class="text-center" {{ block.shopify_attributes }}>
          <p class="text-3xl md:text-4xl font-serif text-primary mb-2">{{ block.settings.stat_value }}</p>
          <p class="text-xs tracking-[0.2em] uppercase text-muted-foreground font-light">{{ block.settings.stat_label }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Technology Meets"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted Word (gold italic)",
      "default": "Craftsmanship"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every RAVORA lamp begins as a digital sculpture, refined through countless iterations before being brought to life layer by layer. The result is a harmony of precision engineering and organic beauty — lighting that transforms spaces and elevates everyday moments."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Value",
          "default": "100%"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "3D Printed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story",
      "blocks": [
        { "type": "stat", "settings": { "stat_value": "100%", "stat_label": "3D Printed" } },
        { "type": "stat", "settings": { "stat_value": "Hand", "stat_label": "Finished" } },
        { "type": "stat", "settings": { "stat_value": "LED", "stat_label": "Integrated" } }
      ]
    }
  ]
}
{% endschema %}
