<div class="pt-36 pb-24 px-6">
  <div class="max-w-4xl mx-auto">
    <!-- Page Title -->
    <h1 class="text-4xl md:text-5xl font-serif italic tracking-tight mb-4">Get in Touch</h1>
    <p class="text-muted-foreground font-light mb-12 max-w-2xl">We'd love to hear from you. Whether you have a question about our products, need help with an order, or just want to say hello — reach out below.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <!-- Contact Form -->
      <div>
        <h2 class="text-lg font-serif italic mb-6 tracking-tight">Send Us a Message</h2>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="bg-primary/10 border border-primary/30 rounded-lg px-5 py-4 mb-6">
              <p class="text-sm text-primary font-light">Thank you for reaching out. We'll get back to you shortly.</p>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="bg-red-500/10 border border-red-500/30 rounded-lg px-5 py-4 mb-6">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="flex flex-col gap-5">
            <div>
              <label for="ContactName" class="block text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-2">Name</label>
              <input type="text" id="ContactName" name="contact[name]" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-5 py-3 text-sm font-light text-white placeholder-zinc-500 focus:outline-none focus:border-primary/50 transition-colors"
                placeholder="Your name">
            </div>
            <div>
              <label for="ContactEmail" class="block text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-2">Email</label>
              <input type="email" id="ContactEmail" name="contact[email]" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-5 py-3 text-sm font-light text-white placeholder-zinc-500 focus:outline-none focus:border-primary/50 transition-colors"
                placeholder="your@email.com">
            </div>
            <div>
              <label for="ContactPhone" class="block text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-2">Phone <span class="normal-case text-zinc-600">(optional)</span></label>
              <input type="tel" id="ContactPhone" name="contact[phone]"
                class="w-full bg-white/5 border border-white/10 rounded-lg px-5 py-3 text-sm font-light text-white placeholder-zinc-500 focus:outline-none focus:border-primary/50 transition-colors"
                placeholder="+91 XXXXX XXXXX">
            </div>
            <div>
              <label for="ContactMessage" class="block text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-2">Message</label>
              <textarea id="ContactMessage" name="contact[body]" rows="5" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-5 py-3 text-sm font-light text-white placeholder-zinc-500 focus:outline-none focus:border-primary/50 transition-colors resize-none"
                placeholder="How can we help?"></textarea>
            </div>
            <button type="submit"
              class="bg-primary text-primary-foreground px-8 py-3 rounded-lg text-sm font-medium tracking-widest uppercase hover:bg-primary/90 transition-all w-full md:w-auto">
              Send Message
            </button>
          </div>
        {% endform %}
      </div>

      <!-- Contact Info Sidebar -->
      <div class="flex flex-col gap-10">
        <div>
          <h2 class="text-lg font-serif italic mb-6 tracking-tight">Other Ways to Reach Us</h2>
          <div class="flex flex-col gap-6">
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-1">Email</p>
                <a href="mailto:{{ section.settings.email }}" class="text-sm text-white hover:text-primary transition-colors font-light">{{ section.settings.email }}</a>
              </div>
            </div>

            {% if section.settings.phone != blank %}
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-1">Phone</p>
                <a href="tel:{{ section.settings.phone }}" class="text-sm text-white hover:text-primary transition-colors font-light">{{ section.settings.phone }}</a>
              </div>
            </div>
            {% endif %}

            {% if section.settings.instagram != blank %}
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-1">Instagram</p>
                <a href="https://instagram.com/{{ section.settings.instagram }}" target="_blank" class="text-sm text-white hover:text-primary transition-colors font-light">@{{ section.settings.instagram }}</a>
              </div>
            </div>
            {% endif %}
          </div>
        </div>

        <div class="border-t border-white/10 pt-8">
          <h3 class="text-xs uppercase tracking-[0.15em] text-muted-foreground font-light mb-3">Response Time</h3>
          <p class="text-sm text-white font-light">We typically respond within 24–48 hours during business days.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "email",
      "label": "Contact Email",
      "default": "hello@ravora.in"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram Handle (without @)",
      "default": "ravora.studios"
    }
  ]
}
{% endschema %}
