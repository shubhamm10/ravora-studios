<!-- "FEATURED" label + heading + 4 product cards with overlay text -->
<section class="py-24 px-6 bg-zinc-950">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-sm tracking-[0.3em] uppercase text-muted-foreground mb-4">{{ section.settings.label }}</p>
      <h2 class="text-4xl md:text-5xl font-serif">{{ section.settings.heading }} <span class="italic text-primary">{{ section.settings.heading_highlight }}</span></h2>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal-stagger">
      {% assign feat_collection = collections[section.settings.collection] %}
      {% if feat_collection.products.size > 0 %}
        {% for product in feat_collection.products limit: 4 %}
          <a href="{{ product.url }}" class="group block relative rounded-2xl overflow-hidden bg-white/5 aspect-[3/4]">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50' }}
            {% endif %}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <!-- Quick Add Overlay -->
            <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3 z-10">
              <div class="glass text-white hover:bg-white/10 rounded-xl px-4 py-3 text-[10px] md:text-xs tracking-widest uppercase transition-colors cursor-pointer" onclick="event.preventDefault(); event.stopPropagation(); openQuickView('{{ product.handle }}');">
                Quick View
              </div>
              <form method="post" action="/cart/add" class="m-0 p-0" onsubmit="event.preventDefault();">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-xl px-4 py-3 text-[10px] md:text-xs tracking-widest uppercase transition-colors" onclick="event.stopPropagation();">
                  Add
                </button>
              </form>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-5 z-[5]">
              <h3 class="text-lg font-serif font-medium mb-1">{{ product.title }}</h3>
              <p class="text-xs text-muted-foreground font-light mb-2">{{ product.description | strip_html | truncate: 60 }}</p>
              <p class="text-xl text-primary font-bold" style="text-shadow: 0 0 12px rgba(234,179,8,0.4);">{{ product.price | money }}</p>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="group block relative rounded-2xl overflow-hidden bg-white/5 aspect-[3/4] flex items-end p-5">
            <div>
              <h3 class="text-lg font-serif font-medium mb-1">Sample Lamp {{ i }}</h3>
              <p class="text-xs text-muted-foreground font-light mb-2">Modern ambient lighting</p>
              <p class="text-xl text-primary font-bold" style="text-shadow: 0 0 12px rgba(234,179,8,0.4);">₹2,499</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Light That Feels Like"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted Word (gold italic)",
      "default": "Architecture"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
